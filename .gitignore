# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# QA artifacts — regenerable via the local screenshot rig; never shipped
/docs/screenshots/

# graphify knowledge graph — regenerable via `graphify update .` (no API cost); not shipped
/graphify-out/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Phase 1 tooling artifacts
.lighthouseci/
playwright-report/
test-results/

# curation contact sheets are disposable review output (regenerate: npm run photos:sheets)
curation/sheets/

# Draft story exports — photographs of shoots nobody has approved for the public site.
# `stories:build` writes drafts here instead of public/stories/ so a story that has not
# been promoted to `portfolio` can be reviewed with `next dev` but can never be committed
# or deployed. Promote the story (visibility: portfolio) and it moves to public/stories/.
/public/stories-draft/
# Local idempotency cache: maps source-photo hashes to already-encoded exports.
/.story-ingest-state.json
